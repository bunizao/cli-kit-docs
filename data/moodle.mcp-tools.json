        "forumId": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "includePostText": {
          "default": true,
          "type": "boolean"
        },
        "titlesOnly": {
          "default": false,
          "type": "boolean"
        },
        "unreadOnly": {
          "default": false,
          "type": "boolean"
        },
