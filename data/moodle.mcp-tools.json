  {
    "name": "search_forums",
    "description": "Matching posts with unit and forum name maps. Use when: forum post text. Not for: find for activity names. Refs: query, optional unit or courseId and forumId. Then: thread with discussion_id. Cost: bounded forum scan; total covers scanned scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          ]
        },
        "courseId": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "forumId": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "includePostText": {
          "default": true,
          "type": "boolean"
        },
        "titlesOnly": {
          "default": false,
          "type": "boolean"
        },
        "unreadOnly": {
          "default": false,
          "type": "boolean"
        },
        "sortBy": {
          "default": "relevance",
          "type": "string",
          "enum": [
            "relevance",
            "recent"
          ]
        },
        "maxForums": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxDiscussionsPerForum": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "submit",
    "description": "Upload local files into an assignment; returns the receipt Moodle shows afterwards. Use when: upload assignment files. Not for: item for status only. Refs: assignment id, same-site URL or UNIT TASK phrase; local file paths. Then: dry_run (default) only plans; show the plan to the person, then rerun with dry_run false; final submits for grading and cannot be undone. Cost: writes to Moodle.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          ]
        },
        "files": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "final": {
          "default": false,
          "type": "boolean"
        },
        "replace": {
          "default": false,
          "type": "boolean"
        },
        "accept_statement": {
          "default": false,
          "type": "boolean"
        },
        "dry_run": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
