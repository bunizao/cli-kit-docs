        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          ]
        },
        "courseId": {
          "type": "integer",
          "exclusiveMinimum": 0
