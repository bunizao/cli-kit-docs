  {
    "name": "search_forums",
    "description": "Matching posts with unit and forum name maps. Use when the user says \"forum post text\". Instead: find for activity names. Input: query, optional unit or courseId and forumId. Then: thread with discussion_id. Cost: bounded forum scan; total covers scanned scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
