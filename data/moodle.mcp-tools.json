        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "discussion_id"
      ],
      "additionalProperties": false
