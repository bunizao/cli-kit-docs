            {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          ]
        },
        "days": {
          "default": 14,
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
