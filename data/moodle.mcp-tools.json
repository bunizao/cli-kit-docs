  {
    "name": "submit",
    "description": "Upload local files into an assignment; returns the receipt Moodle shows afterwards. Use when the user says \"upload assignment files\". Instead: item for status only. Input: assignment id, same-site URL or UNIT TASK phrase; local file paths. Then: dry_run (default) only plans; show the plan to the person, then rerun with dry_run false; final submits for grading and cannot be undone; without a draft stage saving is the submission, so it is refused unless final is true. Cost: writes to Moodle.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          ]
        },
        "files": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "text_file": {
          "type": "string",
          "minLength": 1
        },
        "final": {
          "default": false,
          "type": "boolean"
        },
        "replace": {
          "default": false,
          "type": "boolean"
        },
        "accept_statement": {
          "default": false,
          "type": "boolean"
        },
        "dry_run": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
