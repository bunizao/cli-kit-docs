      "type": "object",
      "properties": {
        "days": {
          "default": 14,
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
